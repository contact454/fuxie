{
  "name": "fuxie",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm typecheck && pnpm test:core && pnpm qa:content && pnpm security:secrets && pnpm build",
    "check:quick": "pnpm typecheck",
    "qa:content": "tsx scripts/content-qa.ts",
    "env:audit": "tsx scripts/env-audit.ts",
    "env:audit:services": "tsx scripts/env-audit.ts --check-services",
    "security:secrets": "tsx scripts/secret-audit.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "smoke:production": "tsx scripts/smoke-local.ts --db",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@fuxie/web",
    "dev:ai": "turbo run dev --filter=@fuxie/ai-service",
    "lint": "turbo run lint",
    "test:core": "pnpm --filter @fuxie/srs-engine test && pnpm --filter @fuxie/web test && pnpm --filter @fuxie/ai-service test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @fuxie/database exec prisma generate",
    "db:push": "pnpm --filter @fuxie/database exec prisma db push",
    "db:migrate": "pnpm --filter @fuxie/database exec prisma migrate dev",
    "db:studio": "pnpm --filter @fuxie/database exec prisma studio",
    "db:seed:dev": "tsx scripts/seed-dev-data.ts",
    "smoke:full-local": "tsx scripts/smoke-full-local.ts",
    "perf:local": "tsx scripts/perf-local.ts",
    "perf:local:warn": "tsx scripts/perf-local.ts --warn-only",
    "check:perf-local": "pnpm smoke:full-local && pnpm perf:local",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "bundle:budget:list": "tsx scripts/bundle-budget.ts --list",
    "check:bundle": "pnpm build && pnpm bundle:budget"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^1.43.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "turbo": "^2.3.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0"
  }
}
