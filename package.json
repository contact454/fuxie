{
  "name": "fuxie",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm typecheck && pnpm test:core && pnpm qa:content && pnpm security:secrets && pnpm build",
    "check:quick": "pnpm lint:asset-paths && pnpm check:asset-integrity && pnpm check:asset-audit && pnpm check:locale-parity && pnpm check:state-shell-coverage && pnpm test:property && pnpm check:visual-audit",
    "check:visual-audit": "tsx scripts/check-visual-audit-pack.ts",
    "test:property": "vitest run --config vitest.property.config.ts --passWithNoTests",
    "check:ai-eval": "pnpm eval:ai && pnpm eval:ai -- --provider --allow-provider-blocked && pnpm eval:ai:readout -- --report-path tmp/ai-eval-runs/readout.md",
    "qa:content": "tsx scripts/content-qa.ts",
    "qa:fuxie-assets": "node scripts/verify-fuxie-global-assets-alpha.cjs",
    "qa:copy-style": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-style-audit.ts",
    "qa:copy-style:fix": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-style-audit.ts --fix-mojibake",
    "qa:text-visual": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/copy-style-audit.ts --scope apps/web/src --scope packages/ui/src/tokens --report-path tmp/text-visual-audit.md --json-report-path tmp/text-visual-audit.json",
    "eval:ai": "tsx scripts/ai-eval-harness.ts",
    "eval:ai:readout": "tsx scripts/ai-eval-readout.ts",
    "eval:ai:academic-review": "tsx scripts/ai-eval-academic-review-pack.ts",
    "eval:ai:academic-signoff": "tsx scripts/ai-eval-academic-signoff.ts",
    "eval:ai:fixture-expansion": "tsx scripts/ai-eval-fixture-expansion.ts",
    "eval:ai:controlled-fixture-patch": "tsx scripts/ai-eval-controlled-fixture-patch.ts",
    "qa:learning-quality": "pnpm qa:content && tsx scripts/generate-content-quality-assets.ts",
    "content:quality-assets": "tsx scripts/generate-content-quality-assets.ts",
    "content:transcript-sources": "tsx scripts/apply-source-transcripts.ts --dry-run",
    "content:pilot-feedback": "tsx scripts/analyze-pilot-feedback.ts",
    "env:audit": "tsx scripts/env-audit.ts",
    "env:audit:services": "tsx scripts/env-audit.ts --check-services",
    "security:secrets": "tsx scripts/secret-audit.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "smoke:production": "tsx scripts/smoke-local.ts --db",
    "smoke:gamification-fixtures": "tsx scripts/check-gamification-pilot-fixtures.ts",
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@fuxie/web",
    "dev:ai": "turbo run dev --filter=@fuxie/ai-service",
    "lint": "turbo run lint",
    "lint:asset-paths": "tsx scripts/lint-asset-registry-references.ts",
    "check:asset-integrity": "tsx --tsconfig apps/web/tsconfig.json scripts/asset-registry-integrity.ts",
    "check:asset-audit": "tsx --tsconfig apps/web/tsconfig.json scripts/asset-audit.ts",
    "check:locale-parity": "tsx scripts/check-locale-parity.ts",
    "check:state-shell-coverage": "tsx --tsconfig apps/web/tsconfig.json scripts/check-state-shell-coverage.ts",
    "test:core": "pnpm --filter @fuxie/srs-engine test && pnpm --filter @fuxie/web test && pnpm --filter @fuxie/ai-service test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @fuxie/database exec prisma generate",
    "db:push": "pnpm --filter @fuxie/database exec prisma db push",
    "db:migrate": "pnpm --filter @fuxie/database exec prisma migrate dev",
    "db:studio": "pnpm --filter @fuxie/database exec prisma studio",
    "db:seed:dev": "tsx scripts/seed-dev-data.ts",
    "smoke:full-local": "tsx scripts/smoke-full-local.ts",
    "perf:local": "tsx scripts/perf-local.ts",
    "perf:local:warn": "tsx scripts/perf-local.ts --warn-only",
    "check:perf-local": "pnpm smoke:full-local && pnpm perf:local",
    "bundle:budget": "tsx scripts/bundle-budget.ts",
    "bundle:budget:list": "tsx scripts/bundle-budget.ts --list",
    "check:bundle": "pnpm build && pnpm bundle:budget",
    "test:integration": "playwright test --config tests/integration/playwright.config.ts",
    "test:integration:perf": "playwright test --config tests/integration/playwright.config.ts tests/integration/perf.spec.ts",
    "test:integration:capture": "playwright test --config tests/integration/playwright.config.ts --project chromium-mobile-capture tests/integration/visual-capture.spec.ts",
    "test:integration:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google/genai": "^1.43.0",
    "@playwright/test": "^1.49.1",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.10.2",
    "dotenv": "^17.3.1",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "pg": "^8.20.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.21.0",
    "turbo": "^2.3.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0"
  }
}
